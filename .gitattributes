# Ensure gradlew has Unix line endings on all platforms
gradlew        text eol=lf
gradlew.bat    text eol=crlf

# Standard text files
*.kt           text eol=lf
*.kts          text eol=lf
*.xml          text eol=lf
*.md           text eol=lf
*.yml          text eol=lf
*.properties   text eol=lf

# Binary files
*.jar          binary
*.apk          binary
*.png          binary
*.jpg          binary
*.webp         binary
